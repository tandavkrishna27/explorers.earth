{
  "version": 1,
  "environment": "qa",
  "hostAlias": "qa-host",
  "sshUser": "deploy",
  "sshPort": 22,
  "knownHostKeyRef": "QA_KNOWN_HOST",
  "architecture": "linux/amd64",
  "dockerVersion": "29.2.1",
  "composeVersion": "2.39.0",
  "publicOrigin": "",
  "internalPorts": { "api": 5000, "web": 80, "postgres": 5432 },
  "database": { "name": "qa_db", "volume": "qa_data", "runtimeRole": "qa_app", "migratorRole": "qa_migrator", "runtimePasswordRef": "QA_DB_PASSWORD_FILE", "migratorPasswordRef": "QA_MIGRATOR_PASSWORD_FILE" },
  "storage": { "bucket": "replace-approved-bucket", "region": "ap-south-1", "prefix": "qa/", "boundary": "application-shared-principal" },
  "google": { "clientIdRef": "GOOGLE_CLIENT_ID", "clientSecretRef": "GOOGLE_CLIENT_SECRET", "callback": "" },
  "appSecretRef": "QA_APP_SECRET",
  "publicConfig": { "origin": "", "apiPath": "/api", "socketPath": "/socket.io" }
}
