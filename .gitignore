# =============================================
# Root .gitignore for ML Project monorepo
# Covers: Node.js, TypeScript, Vite, React,
#         Drizzle ORM, Docker, OS & Editor files
# =============================================

# ----------------------------
# Node.js / NPM
# ----------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.npm
.yarn-integrity
.pnp
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz

# ----------------------------
# Build Outputs
# ----------------------------
dist/
dist-ssr/
build/
out/
.output/
*.tsbuildinfo

# ----------------------------
# Environment Variables
# ----------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local
.env.music.test
.artifacts/
.superpowers/sdd/

# ----------------------------
# TypeScript
# ----------------------------
*.js.map
*.d.ts.map

# ----------------------------
# Vite
# ----------------------------
.vite/
vite.config.ts.timestamp-*

# ----------------------------
# Drizzle ORM
# ----------------------------
drizzle/
*.db
*.sqlite
*.sqlite3

# ----------------------------
# Logs
# ----------------------------
logs/
*.log
*.log.*

# ----------------------------
# Testing & Coverage
# ----------------------------
coverage/
.nyc_output/
test-results/
playwright-report/
playwright/.cache/
.vitest/

# ----------------------------
# Docker
# ----------------------------
.dockerignore-local

# ----------------------------
# OS Files
# ----------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
*~
.fuse_hidden*
.directory
.Trash-*

# ----------------------------
# Editor & IDE
# ----------------------------
# VSCode (keep settings, ignore local overrides)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# JetBrains IDEs
.idea/
*.iml
*.ipr
*.iws

# Vim / Neovim
*.swp
*.swo
*.swn
[._]*.s[a-v][a-z]
[._]*.sw[a-p]
Session.vim
.netrwhist

# Emacs
*~
\#*\#
/.emacs.desktop
/.emacs.desktop.lock
*.elc

# ----------------------------
# Replit (used in sub-projects)
# ----------------------------
.replit
replit.nix
.cache/replit/

# ----------------------------
# Miscellaneous
# ----------------------------
*.temp
*.tmp
*.bak
*.orig
*.patch
*.rej
attached_assets/

# ----------------------------
# Local environment credential folders
# (kept on disk for dev, never committed)
# ----------------------------
explorers environment/
tunes environment/
.replatform-local/

# ----------------------------
# Agent scratch, qualification receipts and isolated clones
# ----------------------------
# These accumulate during qualification runs and are not deliverables: run logs,
# clean-path markers, source-hash snapshots, generated fixture seeds, ad-hoc edit
# scripts and whole isolated repository copies. They were previously un-ignored,
# so a `git add -A` would have published roughly seventy of them, including a
# nested copy of the repository that shadows real paths and corrupts repo-wide
# greps. Prefer staging deliberate paths over relying on -A.
#
# Two things under .superpowers are deliberately preserved: the durable
# implementation ledger in sdd/ (which carries its own ignore rules) and the one
# tracked source-hash receipt. Already-tracked files are unaffected by ignore
# rules regardless; the negations keep that intent legible.
/.superpowers/*
!/.superpowers/sdd/
!/.superpowers/movie-package-a-source-hashes.json
tunes/.superpowers/
tunes/.music-cli-contract-isolated-*/
tunes/scripts/.*.ts
