    "music:local:start": "tsx scripts/music-local.ts start",
    "public-profile:local:start": "tsx scripts/public-profile-local.ts",
    "test:music-critical-coverage": "vitest run server/test/music-surface-policy.test.ts server/test/music-retirement-policy.test.ts server/test/contracts/runtime-surface-inventory.test.ts client/src/lib/musicCredential.test.ts server/test/music-lifecycle-service.test.ts server/test/music-lifecycle-worker.test.ts server/test/strapi-identity-absence-proof.test.ts server/test/music-reconciler.test.ts server/test/reconcileMusicIdentitiesCommand.test.ts server/test/musicReconciliationConfig.test.ts server/test/musicReconciliationSuspensionListener.test.ts server/test/music-publication-response-crypto.test.ts server/test/music-publication-operation-repository.test.ts client/src/lib/musicPublicationClient.test.ts server/test/music-identity-gateway.test.ts server/test/music-identity-route.test.ts server/test/music-credential-route.test.ts server/test/music-lifecycle-route.test.ts server/test/load/music-load-qualification.test.ts server/test/music-token-service.test.ts server/test/music-principal.test.ts server/test/music-critical-gateway-coverage.test.ts server/test/music-critical-identity-coverage.test.ts server/test/music-critical-routes-coverage.test.ts --coverage.enabled=true --coverage.provider=v8 --coverage.reporter=text --coverage.all=true --coverage.include=server/policies/musicSurfacePolicy.ts --coverage.include=server/policies/musicRetirementPolicy.ts --coverage.include=client/src/lib/musicCredential.ts --coverage.include=server/services/musicLifecycleService.ts --coverage.include=server/workers/musicLifecycleWorker.ts --coverage.include=server/services/strapiIdentityAbsenceProof.ts --coverage.include=server/services/musicReconciler.ts --coverage.include=server/commands/reconcileMusicIdentities.ts --coverage.include=server/config/music-reconciliation-config.ts --coverage.include=server/services/musicReconciliationSuspensionListener.ts --coverage.include=server/services/musicPublicationResponseCrypto.ts --coverage.include=server/repositories/musicPublicationOperationRepository.ts --coverage.include=client/src/lib/musicPublicationClient.ts --coverage.include=server/services/strapiIdentityGateway.ts --coverage.include=server/services/musicProjectionService.ts --coverage.include=server/services/musicTokenService.ts --coverage.include=server/middleware/musicPrincipal.ts --coverage.include=server/middleware/identityRateLimit.ts --coverage.include=server/routes/musicIdentityRoutes.ts --coverage.include=shared/musicError.ts --coverage.thresholds.perFile=true --coverage.thresholds.lines=100 --coverage.thresholds.branches=100 --coverage.thresholds.functions=100 --coverage.thresholds.statements=100",
    "test:music-c45:repository-coverage": "vitest run --config vitest.integration.config.ts server/test/migrations/music-migration.integration.test.ts server/test/music-identity-projection.integration.test.ts server/test/music-credential.integration.test.ts server/test/music-domain-repository.integration.test.ts server/test/musicLifecycle.integration.test.ts server/test/musicReconciler.integration.test.ts server/test/music-publication-operation.integration.test.ts server/test/music-runtime-role.integration.test.ts server/test/music-identity-repository-coverage.integration.test.ts --coverage.enabled=true --coverage.provider=v8 --coverage.reporter=text --coverage.all=true --coverage.include=server/repositories/musicIdentityRepository.ts --coverage.thresholds.perFile=true --coverage.thresholds.lines=100 --coverage.thresholds.branches=100 --coverage.thresholds.functions=100 --coverage.thresholds.statements=100",
    "test:music-c8:coverage": "vitest run server/test/music-reconciler.test.ts server/test/reconcileMusicIdentitiesCommand.test.ts server/test/musicReconciliationConfig.test.ts server/test/musicReconciliationSuspensionListener.test.ts --coverage.enabled=true --coverage.provider=v8 --coverage.reporter=text --coverage.all=true --coverage.include=server/services/musicReconciler.ts --coverage.include=server/commands/reconcileMusicIdentities.ts --coverage.include=server/config/music-reconciliation-config.ts --coverage.include=server/services/musicReconciliationSuspensionListener.ts --coverage.thresholds.lines=100 --coverage.thresholds.branches=100 --coverage.thresholds.functions=100 --coverage.thresholds.statements=100",
    "test:music-c8:repository-coverage": "vitest run --config vitest.integration.config.ts server/test/musicReconciler.integration.test.ts server/test/reconciliationRepository.integration.test.ts --coverage.enabled=true --coverage.provider=v8 --coverage.reporter=text --coverage.all=true --coverage.include=server/repositories/reconciliationRepository.ts --coverage.thresholds.lines=100 --coverage.thresholds.branches=100 --coverage.thresholds.functions=100 --coverage.thresholds.statements=100",
    "music:evidence-manifest": "tsx scripts/music-evidence-manifest.ts",
    "music:public-canary": "tsx scripts/evaluate-music-public-canary.ts",
    "music:types:scoped": "tsc --project tsconfig.music-c0.json --pretty false --incremental false",
    "music:types:baseline": "tsx scripts/music-typescript-baseline.ts --compare"
  },
