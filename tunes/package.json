  "scripts": {
    "postinstall": "npm ci --prefix auth-runtime --omit=dev",
    "dev": "tsx --watch server/index.ts",
    "build": "vite build && esbuild server/index.ts server/deployment/run-migration-gate.ts server/deployment/run-registration-compat.ts server/deployment/run-production-graph-smoke.ts --platform=node --packages=external --external:#auth-runtime --bundle --splitting --format=esm --outbase=server --outdir=dist/server",
    "build:api": "node scripts/clean-api-dist.mjs && esbuild server/api.ts server/deployment/run-migration-gate.ts server/deployment/run-registration-compat.ts server/deployment/run-production-graph-smoke.ts --platform=node --packages=external --external:#auth-runtime --bundle --splitting --format=esm --outbase=server --outdir=dist/server",
    "start": "NODE_ENV=production node dist/server/index.js",
    "start:api": "node dist/server/api.js",
    "check": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:real-tool": "vitest run --config vitest.real-tool.config.ts",
    "music:test:uat-database": "tsx scripts/music-uat-database.ts",
    "explorers:test:profile-browser": "tsx scripts/profile-browser-fixture.ts",
    "explorers:test:auth-browser": "tsx scripts/profile-browser-fixture.ts --suite auth",
    "explorers:test:lifecycle-browser": "tsx scripts/profile-browser-fixture.ts --suite lifecycle",
    "explorers:auth:live-local": "tsx scripts/live-google-local.ts",
