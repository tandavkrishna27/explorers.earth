# Database Configuration
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
PGHOST=
PGUSER=
PGPASSWORD=
PGDATABASE=
PGPORT=

# Session Security
SESSION_SECRET=your-session-secret-key
COOKIE_SECRET=your-cookie-secret-key

# JWT (for cross-app SSO with explorers.earth)
STRAPI_JWT_SECRET=your-strapi-jwt-secret

# YouTube API
YOUTUBE_API_KEY=your-youtube-api-key

# Resend Email Configuration
RESEND_API_KEY=re_your-api-key
RESEND_EMAIL_FROM=no-reply@explorers.earth

# Google Maps API
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Analytics
VITE_CLARITY_PROJECT_ID=your-clarity-project-id
CLARITY_PROJECT_ID=your-clarity-project-id

# Optional: Debug Mode (development only)
DEBUG=false

# Optional: Rate Limiting
RATE_LIMIT=60 # Requests per minute

# Port Configuration (default: 3000)
PORT=3000

# Allowed origins for CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,https://explorers.earth

# Spotify Credentials
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret

# Strapi Configuration (explorers.earth Auth Model)
# Server-side configuration
STRAPI_URL=http://your-strapi-host:1337
STRAPI_ACCESS_TOKEN=your-strapi-access-token
STRAPI_ANALYTICS_ACCESS_TOKEN=your-dedicated-strapi-analytics-token

# Client-side Strapi Configuration (for Vite)
# GraphQL endpoint for authentication
VITE_API_URL=http://your-strapi-host:1337/graphql
# REST endpoint for Google OAuth
VITE_REST_API_URL=http://your-strapi-host:1337
# Optional: Public access token for unauthenticated requests
VITE_PUBLIC_ACCESS_TOKEN=

# Razorpay
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-secret-key
RAZORPAY_PLAN_ID_MONTHLY=your-razorpay-monthly-plan-id
RAZORPAY_PLAN_ID_YEARLY=your-razorpay-yearly-plan-id

# Gemini AI
GEMINI_API_KEY=your-gemini-api-key
TRUST_PROXY_CIDRS=loopback,linklocal,uniquelocal
