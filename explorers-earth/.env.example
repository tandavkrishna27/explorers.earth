# Explorers Earth frontend environment variables
# Copy this file to .env and set values for your environment.
# Note: `import.meta.env.DEV` is provided by Vite automatically (do not set it here).

# Required: GraphQL endpoint for Apollo client requests.
VITE_API_URL=http://your-strapi-host:1337/graphql

# Required: Strapi REST base URL for uploads/auth/payments fallback.
VITE_REST_API_URL=http://your-strapi-host:1337

# Required: Google Maps API key (Places, Geocoding, maps rendering).
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Optional: Google Custom Search API key (used in recommendations flow).
VITE_GOOGLE_CUSTOM_SEARCH_API_KEY=your_custom_search_api_key

# Optional: Google Custom Search Engine ID (CSE cx) used in recommendations flow.
VITE_GOOGLE_CUSTOM_SEARCH_ENGINE_ID=your_custom_search_engine_id

# Optional: Legacy Google search API key name used by profile feed search.
VITE_GOOGLE_SEARCH_API_KEY=your_custom_search_api_key

# Optional: Legacy Google search engine ID name used by profile feed search.
VITE_GOOGLE_SEARCH_ENGINE_ID=your_search_engine_id

# Required: Public Strapi token used for unauthenticated GraphQL operations.
VITE_PUBLIC_ACCESS_TOKEN=your_public_access_token

# Optional: Public canonical base URL for share/domain helpers.
VITE_BASE_URL=https://explorers.earth

# Optional: Local Tunes REST API base URL.
VITE_LOCAL_TUNES_API_URL=https://your-tunes-host

# Optional: Local Tunes WebSocket URL.
VITE_LOCAL_TUNES_WS_URL=ws://your-tunes-host

# Optional: Enable Local Tunes integration (true/false).
VITE_LOCAL_TUNES_ENABLED=true

# Optional: Local Tunes request timeout in milliseconds.
VITE_LOCAL_TUNES_TIMEOUT=10000

# Optional: Local Tunes retry attempts for failed requests.
VITE_LOCAL_TUNES_RETRY_ATTEMPTS=3

# Optional: Payment/AI backend base URL (falls back to VITE_REST_API_URL when unset).
VITE_PAYMENT_API_URL=http://localhost:5000

# Optional: Legacy Gemini service base URL used in category mapping fallback.

# Optional: Instagram integration backend base URL.
VITE_INSTAGRAM_API_URL=http://localhost:5000

# Optional: Google Analytics measurement ID.
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Optional: Razorpay key for development mode checkout.
VITE_RAZORPAY_KEY_ID_DEV=rzp_test_xxxxxxxxxx

# Optional: Razorpay key for production mode checkout.
VITE_RAZORPAY_KEY_ID_PROD=rzp_live_xxxxxxxxxx

# Optional: Legacy non-Vite Razorpay key name (kept for compatibility docs/tools).
RAZORPAY_KEY_ID=your_razorpay_key

# Required for Movies & Shows feature: TMDB (The Movie Database) credentials.
# Get your free credentials at: https://developer.themoviedb.org/docs/getting-started
#
# Option A (RECOMMENDED): API Read Access Token — long JWT shown on themoviedb.org/settings/api
# Used as: Authorization: Bearer <token>. Grants same access as API key but is more secure.
VITE_TMDB_ACCESS_TOKEN=your_tmdb_read_access_token_here
#
# Option B (fallback): Short API Key — shown on the same settings page under "API Key"
# Only used if VITE_TMDB_ACCESS_TOKEN is not set.
VITE_TMDB_API_KEY=your_tmdb_api_key_here
