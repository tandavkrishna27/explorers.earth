  "faqs": [
    {
      "Question": "What is explorers.earth?",
      "Answer": "explorers.earth lets you create and share simple travel guides using links and QR codes. Add places, tips, maps, and photos — and share them anywhere.",
      "Sequence": 1
    },
    {
      "Question": "Who can create a guide on explorers.earth?",
      "Answer": "Anyone — travelers, locals, influencers, hosts, cafés, hotels, or businesses.",
      "Sequence": 2
    },
    {
      "Question": "Is explorers.earth free to use?",
      "Answer": "Yes.  explorers.earth is free forever. You can create your QR code, add unlimited recommendations, and track basic analytics at no cost. Premium features for businesses and advanced analytics are available through our paid plans.",
      "Sequence": 3
    },
    {
      "Question": "Do I need to download an app?",
      "Answer": "No. explorers works fully in your browser — scan or tap and you're in.",
      "Sequence": 4
    },
    {
      "Question": "Can I edit my guide after publishing?",
      "Answer": "Yes. You can update your guide anytime, and your QR code stays the same.",
      "Sequence": 5
    },
    {
      "Question": "Where can I share my explorers guide?",
      "Answer": "Instagram, WhatsApp, Airbnb rooms, websites, menus, posters, business cards, or anywhere a QR code can be displayed.",
      "Sequence": 6
    },
    {
      "Question": "What is Local Tunes?",
      "Answer": "Local Tunes is a feature inside explorers.earth that lets you add Spotify/Apple/YouTube Music playlists to your guides — giving places their own vibe and mood.",
      "Sequence": 7
    },
    {
      "Question": " Do I need a separate account for Local Tunes?",
      "Answer": "No. Your explorers.earth account works for both explorers and LocalTunes.",
      "Sequence": 8
    },
    {
      "Question": "How much does Local Tunes cost?",
      "Answer": "LocalTunes has a free plan and a ₹300/month subscription (with a 10% discount for yearly billing) offering unlimited playlists, analytics, and advanced features.",
      "Sequence": 9
    },
    {
      "Question": "Are the QR codes permanent?",
      "Answer": "Yes. Once generated, your QR code never changes — even when you update your guide.",
      "Sequence": 10
    }
  ]
