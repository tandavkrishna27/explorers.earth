# Music fixture build: the root context makes the canonical shared publication
# response contract available without duplicating it in the Explorer bundle.
FROM public.ecr.aws/docker/library/node:24.21.0-alpine@sha256:ebfe2f90462722a7a4de65e91990e97fe0d401c70e0e762c5b53302f905ec1c1 AS builder

WORKDIR /workspace/explorers-earth

ARG VITE_API_URL
ARG VITE_REST_API_URL
ARG VITE_PUBLIC_ACCESS_TOKEN
ARG VITE_CLARITY_PROJECT_ID
ARG VITE_LOCAL_TUNES_API_URL
ARG MUSIC_FIXTURE_BUNDLE_CHECK

ENV VITE_API_URL=$VITE_API_URL \
    VITE_REST_API_URL=$VITE_REST_API_URL \
    VITE_PUBLIC_ACCESS_TOKEN=$VITE_PUBLIC_ACCESS_TOKEN \
    VITE_CLARITY_PROJECT_ID=$VITE_CLARITY_PROJECT_ID \
    VITE_LOCAL_TUNES_API_URL=$VITE_LOCAL_TUNES_API_URL \
    MUSIC_FIXTURE_BUNDLE_CHECK=$MUSIC_FIXTURE_BUNDLE_CHECK

COPY explorers-earth/package.json explorers-earth/package-lock.json ./
RUN npm ci --engine-strict

COPY explorers-earth/ ./
COPY tunes/shared/musicPublicationContract.ts /workspace/tunes/shared/musicPublicationContract.ts
COPY tunes/shared/explorersContract.ts /workspace/tunes/shared/explorersContract.ts
COPY tunes/shared/explorersOwnerContentContract.ts /workspace/tunes/shared/explorersOwnerContentContract.ts
COPY tunes/shared/explorersSearchContract.ts /workspace/tunes/shared/explorersSearchContract.ts
COPY tunes/shared/explorersPublicContentContract.ts /workspace/tunes/shared/explorersPublicContentContract.ts
COPY tunes/shared/explorersRichNoteContract.ts /workspace/tunes/shared/explorersRichNoteContract.ts
COPY tunes/shared/explorersBookContract.ts /workspace/tunes/shared/explorersBookContract.ts
COPY tunes/shared/explorersBookCoverContract.ts /workspace/tunes/shared/explorersBookCoverContract.ts
COPY tunes/shared/explorersMovieContract.ts /workspace/tunes/shared/explorersMovieContract.ts
COPY tunes/shared/explorersMovieMediaContract.ts /workspace/tunes/shared/explorersMovieMediaContract.ts
COPY tunes/shared/explorersAppContract.ts /workspace/tunes/shared/explorersAppContract.ts
COPY tunes/shared/explorersAppEnrichmentContract.ts /workspace/tunes/shared/explorersAppEnrichmentContract.ts
COPY tunes/shared/explorersPlacePinsContract.ts /workspace/tunes/shared/explorersPlacePinsContract.ts
COPY tunes/shared/explorersPlacePinsFraming.ts /workspace/tunes/shared/explorersPlacePinsFraming.ts
COPY tunes/shared/explorersProductContract.ts /workspace/tunes/shared/explorersProductContract.ts
COPY tunes/shared/explorersPersonContract.ts /workspace/tunes/shared/explorersPersonContract.ts
COPY tunes/shared/explorersPublicPeopleSectorContract.ts /workspace/tunes/shared/explorersPublicPeopleSectorContract.ts
COPY tunes/shared/explorersPlaceContract.ts /workspace/tunes/shared/explorersPlaceContract.ts
COPY tunes/shared/explorersPlaceLinkContract.ts /workspace/tunes/shared/explorersPlaceLinkContract.ts
COPY tunes/shared/explorersGuideContract.ts /workspace/tunes/shared/explorersGuideContract.ts
COPY tunes/shared/explorersLifecycleObservation.ts /workspace/tunes/shared/explorersLifecycleObservation.ts
COPY tunes/shared/explorersGameContract.ts /workspace/tunes/shared/explorersGameContract.ts
COPY tunes/shared/explorersGameOwnerContract.ts /workspace/tunes/shared/explorersGameOwnerContract.ts
COPY tunes/shared/explorersTaxonomyContract.ts /workspace/tunes/shared/explorersTaxonomyContract.ts
RUN npm run build

FROM public.ecr.aws/docker/library/nginx:1.27-alpine@sha256:65645c7bb6a0661892a8b03b89d0743208a18dd2f3f17a54ef4b76fb8e2f2a10 AS runner

RUN rm /etc/nginx/conf.d/default.conf
COPY explorers-earth/nginx.music-fixture.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /workspace/explorers-earth/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
